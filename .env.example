# Never commit secrets. Codespaces secret OPENAI_API_KEY is preferred.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-with-your-openai-key
OPENAI_MODEL=gpt-5-mini
OPENAI_MAX_RETRIES=5

# Optional alternate models for model A/B evaluation:
# DEEPSEEK_MODEL=gpt-5-mini
# GPT_OSS_MODEL=gpt-5-nano

# Optional only if the sandbox repo is not under the same GitHub owner:
# SANDBOX_RUNTIME_GIT_URL=https://github.com/<owner>/russells-agent-sandbox.git
# SANDBOX_RUNTIME_REF=v0.1.0
