{
  "name": "CMU Agent Harness + Docker Sandbox",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:4": {}
  },
  "containerEnv": {"UV_LINK_MODE": "copy"},
  "remoteEnv": {"PATH": "${containerEnv:HOME}/.local/bin:${containerEnv:PATH}"},
  "secrets": {
    "OPENAI_API_KEY": {"description": "OpenAI API key; stays in the agent devcontainer, not the task sandbox"},
    "OPENAI_MODEL": {"description": "OpenAI model, such as gpt-5-mini"}
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {"vscode": {
    "extensions": ["ms-python.python", "ms-python.vscode-pylance", "ms-azuretools.vscode-docker", "mikestead.dotenv"],
    "settings": {"python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python", "python.testing.pytestEnabled": true, "python.testing.pytestArgs": ["tests"]}
  }
  }
}
