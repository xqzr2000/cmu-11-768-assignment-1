+def _final_observations(agent: Any) -> list[dict[str, Any]]:
+    """The tool messages produced by the agent's last action, in call order.
+
+    They cannot be recovered from the saved prompt snapshots: the final action's
+    observations follow no later model request, so no snapshot contains them.
+    The live history does, and only the messages after the last assistant action
+    belong to it, which also keeps reused tool-call ids of earlier steps out.
+    """
+
+    history = getattr(agent, "history", None) or []
+    start = 0
+    for index, message in enumerate(history):
+        if isinstance(message, dict) and message.get("role") == "assistant":
+            start = index + 1
+    return [
+        deepcopy(message)
+        for message in history[start:]
+        if isinstance(message, dict) and message.get("role") == "tool"
+    ]
+
+
+def _record_final_observations(trajectory: Path, agent: Any) -> None:
+    """Add ``final_observations`` to the trajectory ``Agent.run`` just wrote.
+
+    The run's own saving block is left untouched: this only re-reads what it
+    produced and appends the one field it cannot know. Failures here are
+    reported rather than raised, so the outcome of the run itself still
+    decides the exit status.
+    """
+
+    data: dict[str, Any] = {}
+    if trajectory.is_file():
+        try:
+            saved = json.loads(trajectory.read_text(encoding="utf-8"))
+        except (OSError, json.JSONDecodeError):
+            saved = None
+        if isinstance(saved, dict):
+            data = saved
+
+    try:
+        data.setdefault("prompts", getattr(agent, "api_prompts", []))
+        data.setdefault("responses", getattr(agent, "api_responses", []))
+        data.setdefault("compactions", getattr(agent, "compaction_events", []))
+        data["final_observations"] = _final_observations(agent)
+        trajectory.parent.mkdir(parents=True, exist_ok=True)
+        trajectory.write_text(json.dumps(data, indent=2), encoding="utf-8")
+    except Exception as exc:
+        print(
+            f"[agent] could not record final observations: {type(exc).__name__}: {exc}",
+            flush=True,
+        )
+
+
